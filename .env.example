# --- Database ---
# Must point to a real Postgres instance (e.g. Vercel Postgres, Neon, Supabase, or your own).
# `prisma generate` works without this, but `prisma migrate`/`db push` require a live connection.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth / Auth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe (test mode) ---
# From https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From the Stripe CLI (`stripe listen`) or your webhook endpoint settings
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Anthropic (AI assistant) ---
# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# --- Stripe Price IDs (optional) ---
# If left unset, checkout falls back to creating ad-hoc Stripe prices from
# each product's priceOneTimeCents at checkout time. Set these once you've
# created matching Products/Prices in the Stripe dashboard for production use.
# These are referenced per-product in the database (Product.stripePriceIdOneTime
# / Product.stripePriceIdSubscription), not as global env vars, but are listed
# here as a reminder of what needs to be configured in Stripe.
